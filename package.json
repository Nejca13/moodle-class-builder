{
  "name": "moodle-class-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Herramienta estática para docentes: genera HTML listo para pegar en el editor TinyMCE de Moodle.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
